---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Directory from '../components/Directory.astro';
import XEmbed from '../components/XEmbed.astro';
import builds from '../data/builds.json';
import { categories } from '../lib/catalog';
import { site } from '../data/site';
---
<Layout>
  <div class="container workspace">
    <aside class="sidebar" aria-label="Directory overview">
      <a class="sidebar-active" href="#directory"><Icon name="grid" /> Explore builds <span>↗</span></a>
      <div class="sidebar-section"><h2 class="eyebrow">Use cases</h2><ul class="category-list">{Object.entries(categories).map(([key, category], i) => <li><span class="category-number">{String(i + 1).padStart(2, '0')}</span><a href={`/categories/${key}`}>{category}</a></li>)}</ul></div>
      <div class="sidebar-note"><span class="little-cross">+</span><h2>Made something<br />with Jev?</h2><p>There’s a place for it here.</p><a class="text-link" href={site.ownerXUrl} target="_blank" rel="noopener noreferrer">Share your build <Icon name="arrow" /></a></div>
      <div class="sidebar-foot">CURATED BY PEOPLE.<br />BUILT FOR THE CURIOUS.</div>
    </aside>
    <div class="page-content">
      <section class="intro" aria-labelledby="page-title">
        <p class="eyebrow intro-eyebrow"><span class="status-dot"></span> A field guide to what’s possible</p>
        <h1 id="page-title">Small decisions.<br /><span>Real possibilities.</span></h1>
        <p class="intro-description">Discover what people are building with Jev.<br class="desktop-break" /> The projects, the experiments, and the people behind them.</p>
      </section>
      <section class="hero-feature" aria-labelledby="hero-title">
        <a class="video-placeholder" href={site.heroPostUrl} target="_blank" rel="noopener noreferrer" aria-label="Watch Jev in 45 seconds by Matija Sosic on X">
          <div class="video-topline"><span class="eyebrow">The quick introduction</span><span class="video-duration">00:45</span></div>
          <div class="video-center"><span class="play-symbol" aria-hidden="true">▶</span><div><h2 id="hero-title">Meet Jev.</h2><p>A little model. A world of possibilities.</p></div></div>
          <div class="video-bottomline"><span>One question. One decision. Keep building.</span><span class="watch-link">Watch on X <Icon name="external" /></span></div>
        </a>
        <div class="video-caption"><span>45 seconds with <a href="https://x.com/MatijaSosic" target="_blank" rel="noopener noreferrer">@MatijaSosic</a></span><span>Original video <Icon name="external" /></span></div>
        <XEmbed url={site.heroPostUrl} />
      </section>
      <section id="directory" class="directory" aria-labelledby="directory-title">
        <div class="section-heading"><div><p class="eyebrow">The directory</p><h2 id="directory-title">Ideas, out in the world.</h2></div><span class="subtle-label">{builds.length} credited builds</span></div>
        <Directory />
      </section>
      <section id="sponsors" class="sponsors" aria-labelledby="sponsor-title">
        <div class="section-heading"><div><p class="eyebrow">A little support goes a long way</p><h2 id="sponsor-title">Be part of what’s next.</h2></div><a class="text-link" href={site.ownerXUrl} target="_blank" rel="noopener noreferrer">Become a sponsor <Icon name="external" /></a></div>
        <div class="sponsor-slots">{Array.from({ length: site.sponsorSlots }, (_, i) => <a class="sponsor-slot" href={site.ownerXUrl} target="_blank" rel="noopener noreferrer" aria-label={`Ask about sponsor slot ${i + 1}, ${site.minimumWeeklyUsd} US dollars per week, on X`}><span class="slot-number">0{i + 1}</span><Icon name="plus" /><span>Your project here</span><strong>${site.minimumWeeklyUsd}<span> / week</span></strong></a>)}</div>
        <p class="sponsor-note">{site.sponsorSlots} placements · ${site.minimumWeeklyUsd} USD per week each · Book directly with us on X.</p>
      </section>
      <section id="about" class="about" aria-labelledby="about-title"><span class="eyebrow">The idea is simple</span><div><h2 id="about-title">Less noise. More building.</h2><p>JevTrends brings real Jev projects into one place, with credit to the people who made them. Explore an idea, follow the original source, and make something of your own.</p><a class="text-link" href={site.ownerXUrl} target="_blank" rel="noopener noreferrer">Say hello <Icon name="arrow" /></a></div></section>
    </div>
  </div>
</Layout>
